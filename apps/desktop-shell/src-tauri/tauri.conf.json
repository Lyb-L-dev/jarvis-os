{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis OS",
  "version": "4.0.0-beta.3",
  "identifier": "dev.lybl.jarvis-os",
  "plugins": {},
  "build": {
    "beforeDevCommand": "npm run prepare:ui",
    "beforeBuildCommand": "npm run prepare:bundle",
    "frontendDist": "../../../.runtime/desktop-dist-ui-v4"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Jarvis OS — 正在启动",
        "url": "splash/index.html",
        "width": 580,
        "height": 700,
        "minWidth": 580,
        "minHeight": 700,
        "maxWidth": 580,
        "maxHeight": 700,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "useLocalToolsDir": true,
    "resources": {
      "../resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Jarvis OS",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
