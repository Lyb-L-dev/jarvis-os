# Jarvis OS local development configuration.
# Copy this file to .env. Never commit the real .env file.

APP_NAME=Jarvis OS
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL started by infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_only@127.0.0.1:5433/jarvis
AUTO_CREATE_SCHEMA=false

# Xiaomi MiMo application API (pay-as-you-go by default).
# Token Plan requires its dedicated Base URL, a tp- key, and explicit opt-in.
# Review Xiaomi's current usage policy before setting the opt-in to true.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro
MIMO_TOKEN_PLAN_ENABLED=false

# DeepSeek is the paid deep-reasoning fallback.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Local private/offline model.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Routing
DEFAULT_MODEL_MODE=standard
ALLOW_DEEPSEEK_AUTO_UPGRADE=false
DEEPSEEK_MAX_AUTO_UPGRADES_PER_REQUEST=1

# Jarvis OS v2 migration flags. Execution paths remain disabled.
# Local, read-only route explanation. It never changes the actual model call.
V2_ROUTER_SHADOW_ENABLED=true
# V3-1.5 RouterV2 gray enforcement. Off returns immediately to ModelRouter.
# When enabled, only the comma-separated intent cohort is enforced.
V2_ROUTER_ENFORCEMENT_ENABLED=false
V2_ROUTER_ENFORCEMENT_INTENTS=conversation
# Sprint 2 prompt registry (wrap-up 2026-08-07): all 8 consumer modules
# (personality/english/knowledge/memory/summary/intelligence/chat/evaluation)
# render from services/prompts; content verified byte-identical.
V2_PROMPT_REGISTRY_ENABLED=true
V2_SHADOW_RUNS_ENABLED=false
V2_POLICY_ENFORCEMENT_ENABLED=false
V2_WORKFLOW_RUNTIME_ENABLED=false
V2_GROWTH_WORKFLOW_ENABLED=false
V2_RESEARCH_WORKFLOW_ENABLED=false
V2_APPROVAL_CENTER_ENABLED=false
# Sprint 29 Tool Gateway. R2 still requires preview, approval, then execution.
V2_TOOL_GATEWAY_ENABLED=false
V2_N8N_PROVIDER_ENABLED=false
# Sprint 31: isolated, read-only public job research. Requires the manual
# setup-browser-worker.ps1 step before this flag is enabled.
V2_BROWSER_RESEARCH_ENABLED=false
TOOL_SANDBOX_ROOT=.data/tool-sandbox
TOOL_APPROVAL_TTL_MINUTES=30
TOOL_FILE_MAX_CHARS=20000
N8N_INGRESS_URL=http://127.0.0.1:5680
N8N_WEBHOOK_SECRET_FILE=.data/n8n-secrets/webhook_secret
N8N_PROVIDER_TIMEOUT_SECONDS=12
N8N_PROVIDER_MAX_RESPONSE_BYTES=131072
BROWSER_WORKER_URL=http://127.0.0.1:5690
BROWSER_WORKER_SECRET_FILE=.data/browser-secrets/webhook_secret
BROWSER_RESEARCH_OUTPUT_ROOT=.data/browser-research
BROWSER_WORKER_TIMEOUT_SECONDS=45
BROWSER_WORKER_MAX_RESPONSE_BYTES=2097152
# Local-only, rebuildable semantic index. Enable only after pgvector migration.
V2_SEMANTIC_MEMORY_ENABLED=false
# Local-only Mem0 candidate evaluation. This never feeds official memory.
V2_MEM0_SHADOW_ENABLED=false
# Reserved for a later explicit decision; keep false during Sprint 28.
V2_MEM0_CHAT_SHADOW_ENABLED=false
MEM0_TELEMETRY=false

# V3 conversational OS (2026-08-07). Off by default; each phase flips its flag
# and keeps a runtime read point + test assertion (Tech Lead frozen surface).
V3_DIALOG_WORKSPACE_ENABLED=false
V3_SSE_ENABLED=false
V3_RELIABLE_EVENT_FEED_ENABLED=false
V3_UI_EVENT_RETENTION_HOURS=168
V3_UI_EVENT_POLL_SECONDS=1.0
V3_MEMORY_NETWORK_ENABLED=false
MEM0_SHADOW_COLLECTION_NAME=jarvis_mem0_shadow
MEM0_SHADOW_HISTORY_DB_PATH=.data/mem0-shadow-history.db
MEM0_SHADOW_LLM_MODEL=jarvis-memory-qwen:latest
MEM0_SHADOW_ACCURACY_THRESHOLD=0.80
MEM0_SHADOW_TIMEOUT_SECONDS=180
SEMANTIC_EMBEDDING_MODEL=bge-m3:latest
SEMANTIC_EMBEDDING_DIMENSIONS=1024
SEMANTIC_INDEX_VERSION=bge-m3-1024-v1
SEMANTIC_EMBEDDING_TIMEOUT_SECONDS=45
SEMANTIC_EMBEDDING_BATCH_SIZE=12
SEMANTIC_CHUNK_CHARS=1600
SEMANTIC_CHUNK_OVERLAP_CHARS=200

# Sprint 36: proactive suggestions are rules-based, never call a model in the
# background, and respect quiet hours and frequency limits.
PROACTIVE_ENABLED=true
PROACTIVE_POLL_SECONDS=1800
PROACTIVE_MAX_PER_SCAN=5
PROACTIVE_DAILY_CAP=10
PROACTIVE_COOLDOWN_HOURS=24
V3_CONVERSATIONAL_PROACTIVE_ENABLED=false
V3_PROACTIVE_EXPIRY_HOURS=72

# V3-4a local voice loop. Run scripts/install-voice.ps1 before enabling.
# Microphone audio remains local and is never written to the business database.
V3_VOICE_LOOP_ENABLED=false
VOICE_STT_MODEL_PATH=C:/tmp/jarvis-stt-model
VOICE_TTS_CHINESE_MODEL_PATH=C:/tmp/jarvis-voice-model
VOICE_TTS_ENGLISH_MODEL_PATH=C:/tmp/jarvis-voice-en-model
VOICE_MODEL_IDLE_SECONDS=300
VOICE_MAX_AUDIO_SECONDS=60
VOICE_MAX_TEXT_CHARS=2000

# Sprint 37: controlled computer-use is opened by stage.
# 1 = read-only inspection, 2 = plans and previews,
# 3 = confirmed sandboxed modifications, 4 = external accounts.
COMPUTER_USE_STAGE=3

# OpenClaw is intentionally deferred. Host-level automation stays disabled
# until VM isolation, permission reduction, plugin audit, and rollback gates pass.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=
OPENCLAW_SHARED_SECRET=

# Information Intelligence automatic morning brief.
INTELLIGENCE_AUTO_BRIEF_ENABLED=true
INTELLIGENCE_DAILY_BRIEF_HOUR=7
INTELLIGENCE_DAILY_BRIEF_MINUTE=45
INTELLIGENCE_POLL_INTERVAL_SECONDS=300

# Investment and international-event monitoring. Sources obey their own refresh interval.
MONITORING_AUTO_ENABLED=true
MONITORING_POLL_SECONDS=300
MONITORING_LOOKBACK_HOURS=72

# Local PostgreSQL backups. Relative paths are resolved from the project root.
BACKUP_ENABLED=true
BACKUP_DIRECTORY=backups
BACKUP_INTERVAL_HOURS=20
BACKUP_RETENTION_COUNT=30

# Sprint 33 · Cost Center local estimates. These are estimates only,
# never vendor invoices. Adjust the per-million-token prices if needed.
COST_ESTIMATE_CURRENCY=CNY
DEEPSEEK_INPUT_PRICE_PER_MILLION=4.0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=16.0

# Obsidian confirmed-memory and daily-brief archive worker.
KNOWLEDGE_AUTO_ARCHIVE_ENABLED=true
KNOWLEDGE_AUTO_ARCHIVE_INTERVAL_SECONDS=300
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_RETRIEVAL_LIMIT=4
KNOWLEDGE_RETRIEVAL_MAX_CHARS=4800

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
